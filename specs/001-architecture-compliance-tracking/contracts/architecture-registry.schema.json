{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AntaresAndBharani Architecture & Way of Working Registry",
  "type": "object",
  "required": [
    "practiceId",
    "practiceName",
    "description",
    "standardVersion",
    "lastUpdated",
    "requiredFiles",
    "repositories"
  ],
  "properties": {
    "practiceId": {
      "type": "string",
      "const": "claude-code-review"
    },
    "practiceName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "standardVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "requiredFiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "repositories": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "repoId",
          "owner",
          "repo",
          "techStack",
          "implemented",
          "syncedVersion",
          "lastUpdated",
          "notes"
        ],
        "properties": {
          "repoId": { "type": "string" },
          "owner": { "type": "string" },
          "repo": { "type": "string" },
          "techStack": { "type": "string" },
          "implemented": { "type": "boolean" },
          "syncedVersion": { "type": "string" },
          "lastUpdated": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
